// Better Auth settings this schema depends on:
//   advanced: { database: { generateId: "uuid" } }
//     Ids then come from @default(uuid(7)) below. Without it sign-up fails,
//     because Better Auth sends its own non-UUID string ids.
//   admin({ ..., defaultRole: "viewer" })
//     Role names and the default must match users.role and its CHECK constraint.
//
// The init migration adds by hand what Prisma can't express: the pg_trgm
// extension (the trigram indexes need it) and CHECK constraints on users.role,
// movies.runtime_minutes and credits.position. Later migrations add credits_star_cast_only,
// reviews_half_stars_range, reviews_spoiler_needs_body and review_comments_body_not_blank the
// same way, and the reviews_sync_movie_rating trigger that keeps a movie's rating columns.
//
// Ids are UUIDv7 generated by Prisma Client, not by the database, and `@updatedAt`
// is filled by Prisma Client too: neither column has a DEFAULT, so raw SQL inserts
// must supply both `id` and `updated_at`.
//
// Create users through Better Auth (auth.api.createUser / signUpEmail), never by
// inserting rows: the password hash lives in accounts, in Better Auth's format.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Better Auth owns User, Session, Account and Verification: model and field names are its
// contract and must not be renamed; table and column names are remapped with @@map / @map.

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  // Always lowercase (the sign-up rule), so the unique index is effectively case-insensitive.
  username      String    @unique
  // Text, not an enum: the admin plugin filters it with string operators. The allowed set is
  // the users_role_valid CHECK constraint; the default must match `defaultRole`.
  role          String    @default("viewer")
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  accounts       Account[]
  movies         Movie[]
  reviews        Review[]
  reviewComments ReviewComment[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id") @db.Uuid
  // The impersonating admin's id. No foreign key: Better Auth declares none, and these
  // sessions expire within the hour.
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The hourly cleanup job deletes by expiry (`deleteExpiredAuthRows`).
  @@index([expiresAt])
  @@map("sessions")
}

// Email + password is the row with providerId = "credential"; its `password` holds the hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Not in Better Auth's own schema: one external identity maps to at most one row.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  // The hourly cleanup job deletes by expiry (`deleteExpiredAuthRows`).
  @@index([expiresAt])
  @@map("verifications")
}

model Movie {
  id             String   @id @default(uuid(7)) @db.Uuid
  // Titles are not unique (Dune 1984 / Dune 2021); the slug is, and it is the seed's upsert key.
  slug           String   @unique
  title          String
  synopsis       String?
  // NOT NULL on purpose: the catalog holds released films only, so every row sorts by a real date
  // and there are no NULLS FIRST surprises.
  releaseDate    DateTime @map("release_date") @db.Date
  runtimeMinutes Int?     @map("runtime_minutes")
  posterUrl      String?  @map("poster_url")
  // The aggregate of the movie's reviews, so the list can sort and filter by rating. The
  // `reviews_sync_movie_rating` trigger keeps all three on every review insert, update and delete
  // (a cascade from a deleted user included); Prisma Client never writes them.
  ratingCount    Int      @default(0) @map("rating_count")
  // The ratings summed in half stars, so the average is recomputed exactly on every change.
  ratingTotal    Int      @default(0) @map("rating_total")
  // The mean in stars, rounded to one decimal (what the pages show, sort and filter on); null
  // without ratings.
  ratingAverage  Float?   @map("rating_average")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  genres    MovieGenre[]
  credits   Credit[]
  reviews   Review[]

  // Makes `contains` + `mode: insensitive` (ILIKE '%term%') indexable. A trigram index needs at
  // least three characters, so search terms are bounded below in the DTO (`searchTermSchema`).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_title_trgm_idx")
  // Sort for the paged lists (ORDER BY ... OFFSET): `id` is the tiebreaker that makes the order total,
  // so a row cannot move between pages.
  @@index([releaseDate, id])
  @@index([title, id])
  // The `added` sort: the admin list's default, the overview's and a user's recent movies.
  @@index([createdAt, id])
  // `createMovie` numbers a taken slug after a `LIKE 'base%'` lookup, which the unique index
  // cannot serve under the database's locale collation; `text_pattern_ops` can.
  @@index([slug(ops: raw("text_pattern_ops"))], map: "movies_slug_pattern_idx")
  // The list's runtime range filter (`runtimeMin` / `runtimeMax`); the release year range reads the
  // `releaseDate` index above.
  @@index([runtimeMinutes])
  // The list's rating range filter (`ratingMin` / `ratingMax`). The "highest rated" sort puts unrated
  // movies last (DESC NULLS LAST), which Prisma cannot declare an index for; it sorts in memory.
  @@index([ratingAverage])
  @@index([createdById])
  @@map("movies")
}

model Genre {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String @map("movie_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([movieId, genreId])
  @@index([genreId, movieId])
  @@map("movie_genres")
}

model Person {
  id          String    @id @default(uuid(7)) @db.Uuid
  // Names are not unique either; the slug is the seed's upsert key.
  slug        String    @unique
  name        String
  bio         String?
  // A calendar day, like movies.release_date. No death date yet: the pages show "Born ..." only.
  birthDate   DateTime? @map("birth_date") @db.Date
  // A `headshot` upload's public URL (attachHeadshot), never a pasted URL.
  headshotUrl String?   @map("headshot_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  credits Credit[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "people_name_trgm_idx")
  // The list's order; `id` breaks ties so a row cannot move between pages.
  @@index([name, id])
  // `createPerson`'s slug lookup, like `movies_slug_pattern_idx`.
  @@index([slug(ops: raw("text_pattern_ops"))], map: "people_slug_pattern_idx")
  @@map("people")
}

enum CreditRole {
  DIRECTOR
  WRITER
  ACTOR

  @@map("credit_role")
}

model Credit {
  movieId  String     @map("movie_id") @db.Uuid
  personId String     @map("person_id") @db.Uuid
  role     CreditRole
  // Display order within a role (first-billed director, cast order).
  position Int        @default(0)
  // A lead the movie's pages highlight. Cast only (`credits_star_cast_only`); independent of
  // `position`, so a star can be billed last ("and Robert De Niro").
  star     Boolean    @default(false)

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // Deleting a person must not silently strip a movie's director.
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([movieId, personId, role])
  @@index([personId, role])
  @@map("credits")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  movieId   String   @map("movie_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  // The rating in half stars: 1 = ½★ … 10 = 5★ (reviews_half_stars_range). DTOs speak stars.
  halfStars Int      @map("half_stars") @db.SmallInt
  body      String?
  // Only a review with text can hold spoilers (reviews_spoiler_needs_body).
  spoiler   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movie    Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments ReviewComment[]

  // One review per user per movie.
  @@unique([movieId, authorId])
  // The newest-first paged list of a movie's reviews; `id` makes the order total.
  @@index([movieId, createdAt, id])
  @@index([authorId])
  @@map("reviews")
}

// A flat comment under a review: no threading, no replies to replies.
model ReviewComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // A review's conversation, oldest first; `id` makes the order total.
  @@index([reviewId, createdAt, id])
  @@index([authorId])
  @@map("review_comments")
}
